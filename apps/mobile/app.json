{
  "expo": {
    "name": "Ascend",
    "slug": "ascend",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "ascend",
    "userInterfaceStyle": "automatic",
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      "expo-image"
    ],
    "android": {
      "usesCleartextTraffic": true
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}
