DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ascend?schema=public"
BETTER_AUTH_SECRET="change-me-in-production"

# Auth server URL — must be reachable from the device running Expo.
# Simulator/emulator: localhost is fine.
# Physical device: use your PC's LAN IP (e.g. http://192.168.29.109:3001).
BETTER_AUTH_URL="http://localhost:3001"
EXPO_PUBLIC_API_URL="http://localhost:3001"
EXPO_PUBLIC_AUTH_URL="http://localhost:3001"

# Dev only: skip Better Auth origin/callback URL checks (default on when NODE_ENV != production).
# Set to "false" to re-enable strict checks locally.
# BETTER_AUTH_DISABLE_ORIGIN_CHECK="true"

# Google OAuth (create at https://console.cloud.google.com/apis/credentials)
# Redirect URI must match BETTER_AUTH_URL, e.g.:
#   http://localhost:3001/api/auth/callback/google
#   http://192.168.29.109:3001/api/auth/callback/google  (physical device)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
